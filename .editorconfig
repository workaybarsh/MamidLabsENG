root = true

[*]
insert_final_newline = true
trim_trailing_whitespace = true

# PowerShell scripts are stored as UTF-8 with BOM: Windows PowerShell 5.1 reads
# non-ASCII characters in BOM-less files incorrectly.
[*.ps1]
charset = utf-8-bom
indent_style = space
indent_size = 4

[*.py]
charset = utf-8
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
charset = utf-8
indent_style = space
indent_size = 2

[*.md]
charset = utf-8
trim_trailing_whitespace = false
